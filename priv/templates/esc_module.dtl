{% extends "esc_layout.dtl" %}
{% block content %}
<div id="module-view">
    <div class="mb-6">
        <a href="/" class="text-indigo-600 hover:underline text-sm">&larr; Back to curriculum</a>
    </div>
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">
            <span class="bg-indigo-100 text-indigo-700 text-sm font-semibold px-2.5 py-0.5 rounded">Module {{ number }}</span>
            <span class="text-gray-400 text-sm">{{ estimated_minutes }} min</span>
        </div>
        <h1 class="text-3xl font-bold text-gray-900">{{ title }}</h1>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-4">{{ section.title }}</h2>
        <div class="prose prose-gray max-w-none mb-6">{{ section.content|safe }}</div>
        {% for example in section.examples %}
        <div class="my-6 rounded-lg border {{ example.border_class }}">
            <div class="px-4 py-2 border-b {{ example.header_class }} flex items-center gap-2">
                <span class="text-sm font-medium {{ example.text_class }}">
                    {{ example.label|safe }}
                </span>
                <span class="text-sm text-gray-600">{{ example.title }}</span>
            </div>
            <pre class="p-4 overflow-x-auto"><code class="language-erlang text-sm">{{ example.code }}</code></pre>
            {% if example.has_output %}
            <div class="px-4 py-2 border-t border-gray-200 bg-gray-50">
                <span class="text-xs text-gray-500 font-medium">Output:</span>
                <pre class="text-sm text-gray-700 mt-1">{{ example.output }}</pre>
            </div>
            {% endif %}
            <div class="px-4 py-3 border-t {{ example.border_class }}">
                <p class="text-sm text-gray-700">{{ example.explanation|safe }}</p>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="flex items-center justify-between mb-8">
        {% if prev_url %}
        <a href="{{ prev_url }}" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">
            &larr; Previous
        </a>
        {% else %}
        <span class="px-4 py-2 bg-gray-200 text-gray-700 rounded opacity-50 cursor-not-allowed">
            &larr; Previous
        </span>
        {% endif %}
        <span class="text-gray-500 text-sm">
            Section {{ section_number }} of {{ total_sections }}
        </span>
        {% if next_url %}
        <a href="{{ next_url }}" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700">
            Next &rarr;
        </a>
        {% else %}
        <span class="px-4 py-2 bg-green-100 text-green-700 rounded text-sm font-medium">
            All sections complete!
        </span>
        {% endif %}
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Knowledge Check</h2>
        <p class="text-gray-600 mb-6">Test your understanding of this module's concepts.</p>

        {% if submitted %}
        <div class="{{ score.banner_class }}">
            <p class="{{ score.text_class }}">
                Score: {{ score.correct }} / {{ score.total }}{{ score.suffix }}
            </p>
        </div>
        {% endif %}

        <form method="post" action="/modules/{{ module_id }}/quiz">
            <input type="hidden" name="section" value="{{ section_index }}" />
            {% for question in questions %}
            <div class="mb-6 p-4 rounded-lg border border-gray-200">
                <p class="font-medium text-gray-900 mb-3">{{ question.prompt|safe }}</p>
                <div class="space-y-2">
                    {% for option in question.options %}
                    <label class="flex items-center gap-3 p-3 rounded-lg cursor-pointer border transition-all {{ option.class }}">
                        <input type="radio" name="q_{{ question.id }}" value="{{ option.id }}"{% if option.checked %} checked{% endif %}{% if submitted %} disabled{% endif %} class="text-indigo-600" />
                        <span class="text-gray-700">{{ option.text|safe }}</span>
                    </label>
                    {% endfor %}
                </div>
                {% if question.show_explanation %}
                <details class="mt-3">
                    <summary class="text-sm text-indigo-600 hover:underline cursor-pointer">Show explanation</summary>
                    <div class="mt-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                        <p class="text-sm text-blue-800">{{ question.explanation|safe }}</p>
                    </div>
                </details>
                {% endif %}
            </div>
            {% endfor %}
            {% if not submitted %}
            <button type="submit" class="mt-6 px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
                Submit Answers
            </button>
            {% endif %}
        </form>
    </div>
</div>
{% endblock %}
