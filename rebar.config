%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

{erl_opts, [debug_info]}.
{src_dirs, [{"src", [{recursive, true}]}]}.
{shell, [{config, "./config/dev_sys.config.src"}]}.

{deps, [
    {nova, {git, "https://github.com/novaframework/nova.git", {branch, "master"}}},
    {cowboy, "2.18.0"},
    {flatlog, "0.1.2"}
]}.

%% Release profiles
{relx, [
    {release, {erlang_secure_coding, git}, [
        erlang_secure_coding,
        sasl
    ]},
    {mode, dev},
    {sys_config_src, "./config/dev_sys.config.src"},
    {vm_args_src, "./config/vm.args.src"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {sys_config_src, "./config/prod_sys.config.src"}
        ]}
    ]},
    {test, [
        {erl_opts, [nowarn_export_all, warnings_as_errors]},
        {ct_opts, [{sys_config, "./config/dev_sys.config.src"}]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_extra_paths, ["test"]}
    ]}
]}.

{erlydtl_opts, [
    {doc_root, "priv/templates"},
    {recursive, true},
    {libraries, [
        {nova_erlydtl_inventory, nova_erlydtl_inventory}
    ]},
    {default_libraries, [nova_erlydtl_inventory]}
]}.

{provider_hooks, [
    {pre, [{compile, {erlydtl, compile}}]}
]}.

{dialyzer, [{plt_apps, all_deps}]}.

{cover_enabled, true}.

%% erlydtl emits beams without a file attribute, which cover cannot instrument.
{cover_excl_mods, [esc_layout_dtl, esc_home_dtl, esc_module_dtl, esc_not_found_dtl]}.

{project_plugins, [
    {rebar3_erlydtl_plugin, ".*",
        {git, "https://github.com/erlydtl/rebar3_erlydtl_plugin.git", {ref, "f1ed9486"}}},
    {rebar3_nova, ".*",
        {git, "https://github.com/novaframework/rebar3_nova.git", {branch, "master"}}},
    {erlfmt, "~>1.7"},
    rebar3_audit,
    rebar3_sbom,
    covertool
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.app.src",
        "src/**/{*.erl, *.hrl}",
        "test/**/{*.erl, *.hrl}"
    ]},
    {exclude_files, ["config/vm.args.src", "config/prod_sys.config.src"]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
